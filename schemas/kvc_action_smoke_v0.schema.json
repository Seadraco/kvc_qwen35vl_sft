    "qp": {"type": "integer", "enum": [30, 31, 32, 33, 34]},
    "alf": {"type": "integer", "enum": [0, 1]},
    "sao": {"type": "integer", "enum": [0, 1]},
    "affine": {"type": "integer", "enum": [0, 4]},
    "geo": {"type": "integer", "enum": [0, 4]},
    "mip": {"type": "integer", "enum": [0, 1]},
    "lfnst": {"type": "integer", "enum": [0, 1]},
